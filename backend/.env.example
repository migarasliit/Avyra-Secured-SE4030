# Copy this file to `.env` and fill in real values for local development.
# `.env` is already covered by the root .gitignore — never commit real secrets.
#
# NOTE: this backend does not use a dotenv-loading library (e.g. spring-dotenv),
# so this file is NOT read automatically by Spring Boot. It documents which
# OS environment variables application.properties expects via ${VAR} / ${VAR:default}
# placeholders. See "Environment setup" in the root README for how to actually
# load these into your shell or IDE run configuration before starting the app.

# --- Database ---
DB_PASSWORD=your_actual_database_password

# --- JWT (required, no default - app fails to start without it) ---
# Must be at least 32 characters (HS256 key material).
JWT_SECRET=your-long-secure-random-string-here
JWT_EXPIRATION_MS=86400000

# --- Google OAuth2 login (optional - falls back to placeholder values that
# will not complete a real Google sign-in, but the app still starts) ---
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
# Where the browser is redirected after a successful Google login.
APP_OAUTH2_REDIRECT_URI=http://localhost:5173

# --- Gemini chatbot API (required, no default) ---
GEMINI_API_KEY=your-gemini-api-key
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-flash:generateContent

# --- Other external API keys ---
HUGGINGFACE_API_KEY=your_huggingface_api_key
OPENAI_API_KEY=your_openai_api_key

# --- PayPal ---
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret

# --- Cookie security ---
# false = allow non-HTTPS localhost testing. Set to true in any deployed/HTTPS environment.
APP_SECURITY_COOKIE_SECURE=false
