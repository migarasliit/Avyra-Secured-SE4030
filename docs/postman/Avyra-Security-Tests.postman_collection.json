{
  "info": {
    "name": "Avyra Security Tests (Vuln 7 & 8 + CSRF + OAuth2)",
    "description": "Covers Member 4's assigned vulnerabilities: #7 Session Hijacking (JWT cookie) and #8 Security Misconfiguration (headers/errors), plus the CSRF protection added alongside them and a sanity check on the Google OAuth2 wiring. See docs/SECURITY-VULN-7-8.md for the full writeup these tests verify.\n\nIMPORTANT: Postman does NOT automatically turn a cookie into a custom header the way the frontend's axios interceptor does. Every request below that needs CSRF protection reads the XSRF-TOKEN cookie in its Pre-request Script and sets it as the X-XSRF-TOKEN header manually. Make sure Postman's cookie jar is enabled (Settings > General > 'Automatically follow redirects' and cookies are on by default) so cookies persist between requests in this collection.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "testUsername", "value": "postman_tester" },
    { "key": "testEmail", "value": "postman_tester@example.com" },
    { "key": "testPassword", "value": "TestPass123!" }
  ],
  "item": [
    {
      "name": "0. Setup",
      "item": [
        {
          "name": "Get CSRF token (seeds XSRF-TOKEN cookie)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/auth/csrf"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('XSRF-TOKEN cookie was set', () => {",
                  "    const cookie = pm.cookies.get('XSRF-TOKEN');",
                  "    pm.expect(cookie).to.not.be.undefined;",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "1. Vulnerability 7 - Session Security (Cookie-based JWT)",
      "item": [
        {
          "name": "Register a test user",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-XSRF-TOKEN", "value": "{{xsrfToken}}" }
            ],
            "url": "{{baseUrl}}/api/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"username\": \"{{testUsername}}\",\n  \"password\": \"{{testPassword}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": { "exec": ["pm.collectionVariables.set('xsrfToken', pm.cookies.get('XSRF-TOKEN'));"] }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Registration succeeds or user already exists (both fine for a repeat run)', () => {",
                  "    pm.expect([200, 400]).to.include(pm.response.code);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Login - verify JWT is set as a cookie, NOT in the response body",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-XSRF-TOKEN", "value": "{{xsrfToken}}" }
            ],
            "url": "{{baseUrl}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{testUsername}}\",\n  \"password\": \"{{testPassword}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": { "exec": ["pm.collectionVariables.set('xsrfToken', pm.cookies.get('XSRF-TOKEN'));"] }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Response body does NOT contain the raw JWT (this is the vuln 7 fix)', () => {",
                  "    const body = pm.response.text();",
                  "    pm.expect(body).to.not.match(/eyJ[a-zA-Z0-9_-]+\\.[a-zA-Z0-9_-]+\\./);",
                  "});",
                  "pm.test('jwtToken cookie was set', () => {",
                  "    pm.expect(pm.cookies.has('jwtToken')).to.be.true;",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Check jwtToken cookie flags via raw Set-Cookie header",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-XSRF-TOKEN", "value": "{{xsrfToken}}" }
            ],
            "url": "{{baseUrl}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{testUsername}}\",\n  \"password\": \"{{testPassword}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": { "exec": ["pm.collectionVariables.set('xsrfToken', pm.cookies.get('XSRF-TOKEN'));"] }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const setCookieHeaders = pm.response.headers.filter('Set-Cookie');",
                  "const jwtCookieHeader = setCookieHeaders.find(h => h.value.startsWith('jwtToken='));",
                  "pm.test('jwtToken cookie is HttpOnly', () => pm.expect(jwtCookieHeader.value).to.include('HttpOnly'));",
                  "pm.test('jwtToken cookie is SameSite=Strict', () => pm.expect(jwtCookieHeader.value).to.include('SameSite=Strict'));",
                  "// Secure flag only appears when APP_SECURITY_COOKIE_SECURE=true (HTTPS deployments). On local HTTP dev this is expected to be absent.",
                  "console.log('Full Set-Cookie for jwtToken:', jwtCookieHeader.value);"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /api/auth/me - authenticated via cookie only, no Authorization header sent",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/auth/me"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200 (cookie alone authenticates)', () => pm.response.to.have.status(200));",
                  "pm.test('Returns the logged-in username', () => {",
                  "    pm.expect(pm.response.json().username).to.eql(pm.collectionVariables.get('testUsername'));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Logout - cookie gets cleared",
          "request": {
            "method": "POST",
            "header": [{ "key": "X-XSRF-TOKEN", "value": "{{xsrfToken}}" }],
            "url": "{{baseUrl}}/api/auth/logout"
          },
          "event": [
            {
              "listen": "prerequest",
              "script": { "exec": ["pm.collectionVariables.set('xsrfToken', pm.cookies.get('XSRF-TOKEN'));"] }
            },
            {
              "listen": "test",
              "script": { "exec": ["pm.test('Status is 200', () => pm.response.to.have.status(200));"] }
            }
          ]
        },
        {
          "name": "GET /api/auth/me after logout - should be 401, not 500",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/auth/me"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 401 (was a 500 bug before the AuthenticationException handler fix)', () => {",
                  "    pm.response.to.have.status(401);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Vulnerability 8 - Security Headers & Error Handling",
      "item": [
        {
          "name": "GET /api/games - inspect security headers",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/games" },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('X-Frame-Options: DENY present (clickjacking protection)', () => {",
                  "    pm.expect(pm.response.headers.get('X-Frame-Options')).to.eql('DENY');",
                  "});",
                  "pm.test('X-Content-Type-Options: nosniff present', () => {",
                  "    pm.expect(pm.response.headers.get('X-Content-Type-Options')).to.eql('nosniff');",
                  "});",
                  "pm.test('Content-Security-Policy present', () => {",
                  "    pm.expect(pm.response.headers.get('Content-Security-Policy')).to.include(\"frame-ancestors 'none'\");",
                  "});",
                  "// Strict-Transport-Security is intentionally ABSENT over plain HTTP (localhost). Spring Security's",
                  "// HSTS writer only emits it on an actual HTTPS connection - sending it over HTTP would be meaningless",
                  "// and browsers ignore it anyway per RFC 6797. Only assert this header once the app is served over HTTPS.",
                  "if (pm.request.url.getProtocol() === 'https') {",
                  "    pm.test('Strict-Transport-Security present (HTTPS only)', () => {",
                  "        pm.expect(pm.response.headers.get('Strict-Transport-Security')).to.include('max-age=');",
                  "    });",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /api/nonexistent-endpoint - no stack trace leaked",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/nonexistent-endpoint-xyz" },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Body does not contain a Java package/class name', () => {",
                  "    const body = pm.response.text();",
                  "    pm.expect(body).to.not.match(/(java\\.|org\\.springframework\\.|backend\\.)[A-Za-z.]+Exception/);",
                  "});",
                  "pm.test('Body does not contain \"stackTrace\" or \"trace\" field', () => {",
                  "    const body = pm.response.text();",
                  "    pm.expect(body.toLowerCase()).to.not.include('trace');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /api/wishlist without login - clean 401, not a raw exception (dead exception handler fix)",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/wishlist" },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 401', () => pm.response.to.have.status(401));",
                  "pm.test('Body is the generic {\"error\":\"Authentication required\"} shape', () => {",
                  "    pm.expect(pm.response.json()).to.eql({ error: 'Authentication required' });",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3. CSRF Protection",
      "item": [
        {
          "name": "POST /api/cart WITHOUT X-XSRF-TOKEN header - expect 403",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/cart/1?quantity=1"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 403 (CSRF rejected the request)', () => pm.response.to.have.status(403));"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /api/cart WITH X-XSRF-TOKEN header - CSRF passes (needs prior login in this run)",
          "request": {
            "method": "POST",
            "header": [{ "key": "X-XSRF-TOKEN", "value": "{{xsrfToken}}" }],
            "url": "{{baseUrl}}/api/cart/1?quantity=1"
          },
          "event": [
            {
              "listen": "prerequest",
              "script": { "exec": ["pm.collectionVariables.set('xsrfToken', pm.cookies.get('XSRF-TOKEN'));"] }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Not a 403 (CSRF token was accepted; a 401 here just means you are not logged in in this run, which is fine)', () => {",
                  "    pm.expect(pm.response.code).to.not.eql(403);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "4. OAuth2 wiring sanity check",
      "item": [
        {
          "name": "GET /oauth2/authorization/google - should redirect to accounts.google.com",
          "request": { "method": "GET", "url": "{{baseUrl}}/oauth2/authorization/google" },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// In Postman, disable 'Automatically follow redirects' in this request's Settings tab to see the raw 302 instead of the final Google page.",
                  "pm.test('Redirects towards Google (302, or 200 if redirects were auto-followed)', () => {",
                  "    pm.expect([200, 302]).to.include(pm.response.code);",
                  "});",
                  "if (pm.response.code === 302) {",
                  "    pm.test('Location header points at accounts.google.com', () => {",
                  "        pm.expect(pm.response.headers.get('Location')).to.include('accounts.google.com');",
                  "    });",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
